# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY deploy/worker/package.json ./package.json
COPY deploy/worker/package-lock.json ./package-lock.json
RUN npm ci --no-audit --no-fund

COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json ./
COPY deploy/worker/build-worker.mjs ./deploy/worker/build-worker.mjs

RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" \
    npm run db:generate

COPY worker ./worker
COPY lib ./lib

RUN npm run build


FROM node:22-bookworm-slim AS runtime-dependencies

WORKDIR /app

COPY deploy/worker/runtime/package.json ./package.json
COPY deploy/worker/runtime/package-lock.json ./package-lock.json

# The builder image and the distroless runtime detect different Prisma engine
# targets, so fetch the ones the runtime actually resolves (see
# get/platform: debian x64 and arm64 on OpenSSL 3.0). Without this the CLI tries
# to download the engine on first use, which the read-only image rejects.
ENV PRISMA_CLI_BINARY_TARGETS="debian-openssl-3.0.x,linux-arm64-openssl-3.0.x"

RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force


FROM gcr.io/distroless/nodejs22-debian13:nonroot AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS="--enable-source-maps --network-family-autoselection-attempt-timeout=2000"

# Owned by nonroot so the CLI can still cache an engine at start on platforms
# whose binary was not pre-fetched above.
COPY --chown=65532:65532 --from=runtime-dependencies /app/node_modules ./node_modules
COPY --from=runtime-dependencies /app/package.json ./package.json

COPY --from=builder /app/dist/worker.mjs ./dist/worker.mjs
COPY --from=builder /app/dist/worker.mjs.map ./dist/worker.mjs.map

# Migrations run at container start, so the schema, migration history and the
# Prisma config that points at DATABASE_URL ship with the image.
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY deploy/worker/start.mjs ./start.mjs

CMD ["start.mjs"]